# On Learning Searcher
# API endpoint for future backend integration
VITE_API_MODE=mock
VITE_API_BASE_URL=https://api.example.com
VITE_SSO_LOGIN_URL=https://sso.example.com/login
VITE_SSO_LOGOUT_URL=https://sso.example.com/logout
VITE_SSO_CALLBACK_URL=http://localhost:5173/auth/callback
VITE_DISABLED_FEATURES=
VITE_API_RETRY_COUNT=1
VITE_ERROR_REPORT_URL=

# Analytics key (optional)
VITE_ANALYTICS_KEY=

# E-campus deep link for course enrollment handoff
VITE_ECAMPUS_COURSE_APPLY_URL=https://ecampus.example.com/course/apply

# Enable debug actions on home (demo/reset/role switch)
VITE_DEBUG_TOOLS=0

# Local remote rehearsal (optional)
# 1) `npm run api:remote-mock`
# 2) set VITE_API_MODE=remote and VITE_API_BASE_URL=http://localhost:8787
