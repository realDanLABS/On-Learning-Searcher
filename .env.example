# On Learning Searcher
# same-origin `/api` is the default in local dev, build, and Vercel
NEXT_PUBLIC_API_BASE_URL=/api

# Local remote rehearsal (optional)
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://...

# Vercel + Supabase
# Keep SUPABASE_SERVICE_ROLE_KEY outside committed/local project env when possible.
# SUPABASE_SERVICE_ROLE_KEY=keep-this-outside-local-project-env-when-possible
